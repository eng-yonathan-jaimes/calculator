<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this theme only controls the window before the first frame. -->
    <style name="Theme.FloatCalc" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Invisible helper activities (trampoline, clipboard reader). -->
    <style name="Theme.FloatCalc.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
